# Public URL, used for OG images, canonical links, sitemap.xml and robots.txt
# Also set directly as the `site.url` default in nuxt.config.ts, so this only
# needs to change here if the domain changes.
NUXT_PUBLIC_SITE_URL=https://edwardomondi.github.io
# This is a user/org GitHub Pages site (EdwardOmondi.github.io repo), served
# from the domain root - do not set this to a subpath.
NUXT_APP_BASE_URL=/
